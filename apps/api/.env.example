# Dual Contract Flow — Phase 1
# When NEXT_PUBLIC_DUAL_FLOW_ENABLED=true, both flows are active.

# ─── Feature Flag ────────────────────────────────────────────────────────────
NEXT_PUBLIC_DUAL_FLOW_ENABLED=false

# ─── eERC Flow (Veila — transferencia privada) ────────────────────────────────
# Contract address for the EncryptedERC (eERC) flow.
NEXT_PUBLIC_EERC_CONTRACT_ADDRESS=0xYourEERCAddressHere
# Mode: 'standalone' | 'bridge' (defaults to 'standalone' if unset)
NEXT_PUBLIC_EERC_MODE=standalone

# ─── Vault Flow (Liquidación AVAX — flujo legacy) ───────────────────────────
# Contract address for the InterbankVault (Vault) flow.
NEXT_PUBLIC_VAULT_CONTRACT_ADDRESS=0x08034625696dC863AD00c2920216055236763Cbb

# ─── Shared RPC (Fuji testnet) ─────────────────────────────────────────────────
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc