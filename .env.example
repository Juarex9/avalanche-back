# Environment Variables — InterbankVault MVP
# Copy to .env and fill in values before running deploy scripts

# Deployer private key (with AVAX on Fuji for deployment)
PRIVATE_KEY=0x...

# FinNova Gnosis Safe address (the only address allowed to call release)
FIN_NOVA_SAFE=0x...

# Optional: if FIN_NOVA_SAFE is a mock EOA, key to sign `release` txs (never commit real keys)
# FIN_NOVA_SIGNER_PRIVATE_KEY=0x...

# CNBV view public key (SECP256k1 uncompressed, first 32 bytes as bytes32)
CNBV_VIEW_PUB_KEY=0x...

# EIP-712 domain separator values
EIP712_NAME=InterbankVault
EIP712_VERSION=1

# Optional: Fuji RPC URL (for fork tests)
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Optional: Etherscan API key for contract verification
FUJI_API_KEY=...

# --- Indexer stub ---
# Deployed InterbankVault address on Fuji
INDEXER_VAULT_ADDRESS=0x...

# Starting block for event queries (set to vault deployment block)
INDEXER_FROM_BLOCK=0